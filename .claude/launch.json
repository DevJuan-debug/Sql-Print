{
  "version": "0.0.1",
  "configurations": [
    {
      "name": "merfresh",
      "runtimeExecutable": "npm",
      "runtimeArgs": [
        "start"
      ],
      "port": 3001,
      "env": {
        "PORT": "3001"
      },
      "autoPort": true
    },
    {
