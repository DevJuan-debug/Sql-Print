# Copia este archivo como .env y completa los valores de tu proyecto de Supabase
# (Supabase → Project Settings → API).

# URL del proyecto, p. ej. https://abcdefghijklmnop.supabase.co
SUPABASE_URL=

# Clave pública "anon" (o "publishable", sb_publishable_…). NUNCA la service_role/secret.
SUPABASE_ANON_KEY=

# Puerto del servidor
PORT=3001

# Dirección pública de la app, para que los enlaces para compartir funcionen fuera de tu equipo
# (p. ej. https://merfresh.midominio.com). Si se deja vacío se usa la dirección desde la que se abre.
PUBLIC_URL=

# Proveedores de inicio de sesión adicionales habilitados en Supabase (opcional): google,github
AUTH_PROVIDERS=
